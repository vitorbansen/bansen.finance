# Banco (Neon/Postgres). Host "-pooler" para a aplicação; tabelas no schema "nkiphones".
DATABASE_URL="postgresql://USER:PASS@HOST-pooler/neondb?sslmode=require&connection_limit=5&pool_timeout=20&schema=nkiphones"
# Conexão direta (sem -pooler) — usada só pelas migrações do Prisma.
DIRECT_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require&schema=nkiphones"

# Segredo do login (JWT) — 32+ caracteres aleatórios.
JWT_SECRET="segredo-aleatorio-com-32-ou-mais-caracteres"

# Opcional: senha do usuário demo criado pelo seed (padrão: demo12345).
SEED_SENHA=""
